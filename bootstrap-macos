#!/usr/bin/env bash
# macOS bootstrap: Xcode CLT, Homebrew + Brewfile, tailscaled, GPG pinentry,
# oh-my-zsh, Claude Code, and symlinks. Runs as the user; only the steps that
# need root call sudo. Safe to re-run; re-runs also upgrade outdated Brewfile
# entries. For Ubuntu, use bootstrap-ubuntu.
set -euo pipefail

if [ "$(uname -s)" != Darwin ]; then
	echo "bootstrap-macos is for macOS; use bootstrap-ubuntu on Linux." >&2
	exit 1
fi

cd "$(dirname "$0")"
. ./bootstrap-common.sh
require_dotfiles_location

step "Xcode Command Line Tools"
if ! xcode-select -p >/dev/null 2>&1; then
	xcode-select --install
	echo "Re-run this script once the Command Line Tools finish installing."
	exit 1
fi
echo "installed"

step "Homebrew"
load_brew() {
	if [ -x /opt/homebrew/bin/brew ]; then
		eval "$(/opt/homebrew/bin/brew shellenv)"
	elif [ -x /usr/local/bin/brew ]; then
		eval "$(/usr/local/bin/brew shellenv)"
	fi
}
load_brew
if ! command -v brew >/dev/null; then
	/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
	load_brew
fi

step "Brewfile"
brew bundle install --file="$DOTFILES/Brewfile"

# tailscaled needs root, so it runs as a system daemon rather than a user agent.
step "tailscaled"
if pgrep -qx tailscaled; then
	echo "running"
else
	sudo brew services start tailscale
fi

step "gpg-agent pinentry"
mkdir -p "$HOME/.gnupg"
chmod 700 "$HOME/.gnupg"
conf="$HOME/.gnupg/gpg-agent.conf"
if grep -q '^pinentry-program' "$conf" 2>/dev/null; then
	grep '^pinentry-program' "$conf"
else
	echo "pinentry-program $(brew --prefix)/bin/pinentry-mac" >> "$conf"
	gpgconf --kill gpg-agent
	echo "set to $(brew --prefix)/bin/pinentry-mac"
fi

# Link first, so oh-my-zsh and the plugin installs find the linked .zshrc and
# settings.json instead of creating their own.
link_dotfiles
install_oh_my_zsh
install_claude_code
install_claude_plugins
install_user_harness
stub_gitconfig_local
setup_signing_key
stub_board_config

step "Done. Manual steps are in README.md."

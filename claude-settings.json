{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(brew install:*)",
      "WebSearch",
      "Bash(board list:*)",
      "Bash(board view:*)",
      "Bash(board fields)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.secrets)",
      "Read(//**/.env.production)",
      "Read(//**/.env.development)"
    ],
    "defaultMode": "auto"
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Merging a GitHub PR with `gh pr merge` (never --admin) in a repo containing a .uh/ user harness with UH_AUTONOMY >= 2, when the harness `reviewer` subagent has posted a mergeable verdict on that same PR earlier in this session and its required checks pass"
    ]
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.dotfiles/claude-hooks/tmux-turn.sh on"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.dotfiles/claude-hooks/tmux-turn.sh on"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.dotfiles/claude-hooks/tmux-turn.sh off"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.dotfiles/claude-hooks/no-claude-attribution.sh",
            "if": "Bash(git *)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.dotfiles/claude-hooks/tmux-turn.sh off"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.dotfiles/claude-hooks/tmux-turn.sh on"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.dotfiles/claude-hooks/tmux-turn.sh agent-stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.dotfiles/claude-hooks/tmux-turn.sh off"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.dotfiles/claude-hooks/tmux-turn.sh agent-start"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.dotfiles/claude-hooks/statusline.sh\""
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "slidev@slidev-plugins": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "slidev-plugins": {
      "source": {
        "source": "github",
        "repo": "slidevjs/slidev"
      }
    }
  },
  "feedbackDrafts": "off",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "theme": "dark"
}

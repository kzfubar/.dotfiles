{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.secrets)",
      "Read(//**/.env.production)",
      "Read(//**/.env.development)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.dotfiles/claude-hooks/no-claude-attribution.sh",
            "if": "Bash(git *)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.config/iterm2/cc-status\" ] || \"$HOME/.config/iterm2/cc-status\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "slidev@slidev-plugins": true
  },
  "extraKnownMarketplaces": {
    "slidev-plugins": {
      "source": {
        "source": "github",
        "repo": "slidevjs/slidev"
      }
    }
  },
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
